# Static export header config ( honoured by Cloudflare Pages & Netlify ).
# Next.js `output: "export"` cannot set response headers itself, so the
# wallpaper and other static assets declare their caching here.

# Fingerprinted build output: safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Static assets (wallpaper, resume, icons). Long-lived but revalidatable, so a
# changed wallpaper still reaches returning visitors without a hard refresh.
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
